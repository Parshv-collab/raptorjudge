# RaptorJudge — environment variables for the `docker compose up` stack.
#
# NOTE ON THE FILENAME: this is the `.env.example` template. It is named
# `env.example` (no leading dot) because this workspace's tooling reserves
# `.env*` filenames. Copy it into place before your first run:
#
#     cp env.example .env
#
# Docker Compose reads `.env` from this directory for ${VAR} substitution.
# `.env` is git-ignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Convex self-hosted backend
# ---------------------------------------------------------------------------

# Root secret for the backend. Anyone holding it can deploy code to and read
# from your deployment. 64 hex chars, e.g. `openssl rand -hex 32`.
# The default below is a throwaway dev value -- ROTATE IT before any real use.
INSTANCE_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Admin key required to push functions / run `convex` commands against the
# self-hosted backend. Self-hosted Convex mints this from INSTANCE_SECRET, so
# it is a ONE-TIME bootstrap step (see README, "Docker & self-hosting"):
#
#   docker compose up -d db backend
#   docker compose exec backend ./generate_admin_key.sh
#
# Paste the printed key here, then run `docker compose up --build`.
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Origins the *browser* uses to reach the backend.
#   CONVEX_CLOUD_ORIGIN -> Convex client API (queries/mutations/actions/sync)
#   CONVEX_SITE_ORIGIN  -> HTTP actions, i.e. the REST API at /api/*
CONVEX_CLOUD_ORIGIN=http://localhost:3210
CONVEX_SITE_ORIGIN=http://localhost:3211

# ---------------------------------------------------------------------------
# Frontend -- baked into the static bundle at build time (Vite inlines VITE_*)
# ---------------------------------------------------------------------------
# Changing this requires a rebuild: `docker compose build frontend`
VITE_CONVEX_URL=http://localhost:3210

# ---------------------------------------------------------------------------
# Bootstrap behaviour
# ---------------------------------------------------------------------------
# Seed the deterministic Dogfood 2026 fixtures on first run.
SEED_ON_START=true

# Site origin used by Convex Auth (only needed for OAuth/email links; this
# project uses password auth, so it is informational).
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Convex Auth signing keys (self-hosted deployments)
# ---------------------------------------------------------------------------
# Convex Auth needs a JWT signing keypair on the deployment. `npx
# @convex-dev/auth` normally sets these, but it does not support self-hosted
# deployments, so the bootstrap container generates and sets them for you.
#
# To generate/publish them by hand instead:
#   npm run keys:generate                     # prints JWT_PRIVATE_KEY + JWKS
#   npx convex env set JWT_PRIVATE_KEY '<...>'
#   npx convex env set JWKS '<...>'
#
# Set SKIP_AUTH_KEYS=true to skip the automatic step.
SKIP_AUTH_KEYS=false
